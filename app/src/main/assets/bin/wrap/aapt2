#!/system/bin/sh
# aapt2: standalone wrapper (no global LD_LIBRARY_PATH leak).
if [ -z "${HOME:-}" ]; then export HOME="/data/user/0/a.opencode/files/server-home"; fi
U="$HOME/toolchain/usr"
BIN="$U/bin/aapt2.real"
if [ ! -f "$BIN" ]; then BIN="$U/bin/aapt2"; fi
LD_LIBRARY_PATH="$U/lib" exec "$BIN" "$@"
