#!/system/bin/sh
# apksigner: standalone wrapper for Android APK signer
if [ -z "${HOME:-}" ]; then export HOME="/data/user/0/a.opencode/files/server-home"; fi
JAVA_BIN="$HOME/toolchain/bin/java"
JAR="$HOME/android-sdk/build-tools/35.0.0/lib/apksigner.jar"
if [ ! -f "$JAR" ]; then JAR="$HOME/android-sdk/build-tools/34.0.0/lib/apksigner.jar"; fi
exec "$JAVA_BIN" -Djava.io.tmpdir="$HOME/tmp" -jar "$JAR" "$@"
