#!/bin/sh
# Service helper for daemons in Debian proot (cron, etc.)
SERVICE="$1"
ACTION="$2"

PIDFILE="/var/run/cron.pid"

case "$SERVICE" in
  cron)
    case "$ACTION" in
      start)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
            echo "cron already running ($(cat "$PIDFILE"))"
            exit 0
        fi
        mkdir -p /var/run /root/.opencode 2>/dev/null || true
        nohup /usr/local/bin/cron-daemon >/dev/null 2>&1 &
        i=0
        while [ $i -lt 10 ]; do
            if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
                echo "Starting periodic command scheduler: cron."
                exit 0
            fi
            sleep 0.2
            i=$((i+1))
        done
        echo "cron started."
        exit 0
        ;;
      stop)
        if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null || true
            rm -f "$PIDFILE"
        fi
        pkill -f cron-daemon 2>/dev/null || true
        echo "Stopping periodic command scheduler: cron."
        exit 0
        ;;
      status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
            echo "cron is running."
            exit 0
        elif pgrep -f cron-daemon >/dev/null 2>&1; then
            echo "cron is running."
            exit 0
        else
            nohup /usr/local/bin/cron-daemon >/dev/null 2>&1 &
            sleep 0.2
            if pgrep -f cron-daemon >/dev/null 2>&1 || ([ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null); then
                echo "cron is running."
                exit 0
            fi
            echo "cron is not running."
            exit 3
        fi
        ;;
      restart|reload|force-reload)
        $0 cron stop
        sleep 0.5
        $0 cron start
        ;;
      *)
        echo "Usage: service cron {start|stop|restart|status}"
        exit 1
        ;;
    esac
    ;;
  *)
    echo "service: unrecognized service $SERVICE" >&2
    exit 1
    ;;
esac
