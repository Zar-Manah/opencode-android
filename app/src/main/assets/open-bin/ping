#!/bin/sh
# Lightweight ping simulation using TCP / HTTP reachability for proot without ICMP
TARGET=""
for arg in "$@"; do
    case "$arg" in
        -*) ;;
        *) [ -z "$TARGET" ] && TARGET="$arg" ;;
    esac
done

if [ -z "$TARGET" ]; then
    echo "Usage: ping <host>" >&2
    exit 1
fi

if curl -sI --connect-timeout 3 "https://$TARGET" >/dev/null 2>&1 || \
   curl -sI --connect-timeout 3 "http://$TARGET" >/dev/null 2>&1; then
    echo "PING $TARGET ($TARGET): 56 data bytes"
    echo "64 bytes from $TARGET: icmp_seq=1 ttl=64 time=14.2 ms"
    echo "--- $TARGET ping statistics ---"
    echo "1 packets transmitted, 1 received, 0% packet loss, time 14ms"
    exit 0
else
    if [ "$TARGET" = "127.0.0.1" ] || [ "$TARGET" = "localhost" ]; then
        echo "PING $TARGET (127.0.0.1): 56 data bytes"
        echo "64 bytes from 127.0.0.1: icmp_seq=1 ttl=64 time=0.2 ms"
        echo "--- $TARGET ping statistics ---"
        echo "1 packets transmitted, 1 received, 0% packet loss, time 0ms"
        exit 0
    fi
    echo "ping: cannot resolve $TARGET: Unknown host" >&2
    exit 1
fi
