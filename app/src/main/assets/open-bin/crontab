#!/bin/sh
# crontab CLI for Debian environment in OpenCode
CRON_FILE="/root/.opencode/crontab.txt"
SPOOL_FILE="/var/spool/cron/crontabs/root"
mkdir -p /root/.opencode /var/spool/cron/crontabs 2>/dev/null || true

if [ "$1" = "-l" ]; then
    if [ -f "$CRON_FILE" ]; then
        cat "$CRON_FILE"
        exit 0
    elif [ -f "$SPOOL_FILE" ]; then
        cat "$SPOOL_FILE"
        exit 0
    else
        echo "# No crontab for root"
        exit 0
    fi
elif [ "$1" = "-e" ]; then
    ${EDITOR:-nano} "$CRON_FILE"
    cp -f "$CRON_FILE" "$SPOOL_FILE" 2>/dev/null || true
    chmod 600 "$SPOOL_FILE" 2>/dev/null || true
    exit 0
elif [ "$1" = "-r" ]; then
    rm -f "$CRON_FILE" "$SPOOL_FILE"
    exit 0
elif [ -n "$1" ] && [ -f "$1" ]; then
    cp -f "$1" "$CRON_FILE"
    cp -f "$1" "$SPOOL_FILE" 2>/dev/null || true
    chmod 600 "$SPOOL_FILE" 2>/dev/null || true
    echo "crontab: new crontab installed"
    exit 0
elif [ -t 0 ]; then
    echo "Usage: crontab [-u user] {-l | -r | -e | file}" >&2
    exit 1
else
    # stdin
    cat > "$CRON_FILE"
    cp -f "$CRON_FILE" "$SPOOL_FILE" 2>/dev/null || true
    chmod 600 "$SPOOL_FILE" 2>/dev/null || true
    exit 0
fi
