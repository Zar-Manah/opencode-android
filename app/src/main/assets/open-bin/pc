#!/bin/bash
# pc: total native control of Android device from Debian in OpenCode
# Architecture: Permanent Native HTTP Bridge (127.0.0.1:4399) with ADB fallback (127.0.0.1:5555).
# 100% autonomous: survives reboots, no USB, no WiFi, no root required.
set -e

# Prioritize real system binaries before host prefix
export PATH="/usr/local/bin:/usr/bin:/bin:/open-prefix/bin:$PATH"

# Resolve real curl executable (prevents wrapper loops)
CURL_EXEC=""
if [ -x /system/bin/curl ]; then
    CURL_EXEC="/system/bin/curl"
elif [ -x /usr/bin/curl ] && head -c 2 /usr/bin/curl 2>/dev/null | grep -qv '#!'; then
    CURL_EXEC="/usr/bin/curl"
elif [ -x /usr/local/bin/curl ]; then
    CURL_EXEC="/usr/local/bin/curl"
elif command -v curl >/dev/null 2>&1; then
    CURL_EXEC="$(command -v curl)"
fi

curl() {
    if [ -n "$CURL_EXEC" ]; then
        "$CURL_EXEC" "$@"
    else
        command curl "$@"
    fi
}

BRIDGE_URL="http://127.0.0.1:4399"

fetch_bridge() {
    local path="$1"
    local max_t="${2:-5}"
    local out=""
    for attempt in 1 2 3; do
        out=$(curl -s --noproxy "*" --connect-timeout 2 --max-time "$max_t" "$BRIDGE_URL$path" 2>/dev/null || echo "")
        if [ -z "$out" ] && command -v python3 >/dev/null 2>&1; then
            out=$(python3 -c "import urllib.request; req=urllib.request.urlopen('$BRIDGE_URL$path', timeout=$max_t); print(req.read().decode('utf-8', 'ignore'))" 2>/dev/null || echo "")
        fi
        if [ -n "$out" ]; then
            echo "$out"
            return 0
        fi
        sleep 0.2
    done
    return 1
}

is_bridge_alive() {
    fetch_bridge "/status" 3 | grep -q '"ok":true'
}

is_adb_alive() {
    local adb_bin="/open-prefix/bin/adb"
    [ -x "$adb_bin" ] && timeout 1 "$adb_bin" -s 127.0.0.1:5555 get-state 2>/dev/null | grep -q "device"
}

cmd="$1"
shift || true

case "$cmd" in
  status)
    echo "=== OpenCode Device Control Status ==="
    
    # 1. Native A11y Bridge check
    status_json=$(fetch_bridge "/status" 3 || echo "")
    if [ -n "$status_json" ] && echo "$status_json" | grep -q '"ok":true'; then
        echo "Native Bridge (Port 4399): ACTIVE (Accessibility Service connected)"
        batt=$(echo "$status_json" | sed -n 's/.*"battery":\([^,}]*\).*/\1/p')
        screen=$(echo "$status_json" | sed -n 's/.*"screen_on":\([^,}]*\).*/\1/p')
        top_app=$(echo "$status_json" | sed -n 's/.*"top_app":"\([^"]*\)".*/\1/p')
        sdk=$(echo "$status_json" | sed -n 's/.*"sdk":\([^,}]*\).*/\1/p')
        echo "  Battery: ${batt}% | Screen: ${screen} | Top App: ${top_app:-termux}"
        echo "  Android SDK: $sdk"
    else
        echo "Native Bridge (Port 4399): Inactive (Enable OpenCode in Android Settings > Accessibility)"
    fi

    # Non-blocking ADB check
    if is_adb_alive; then
        echo "ADB Shell (UID 2000): CONNECTED (127.0.0.1:5555)"
    else
        echo "ADB Shell (UID 2000): Inactive (Optional: covered by Native Bridge)"
    fi
    ;;

  shot)
    out="${1:-/bridge/shot.png}"
    mkdir -p "$(dirname "$out")"
    tmp_shot="$(dirname "$out")/.tmp_shot_$$.png"

    # Try native bridge (ultra-fast, direct to RAM, up to 3 attempts)
    for attempt in 1 2 3; do
        if curl -s --noproxy "*" --connect-timeout 2 --max-time 8 "$BRIDGE_URL/shot" -o "$tmp_shot" 2>/dev/null && \
           [ -s "$tmp_shot" ] && head -c 8 "$tmp_shot" | grep -q "PNG"; then
            mv -f "$tmp_shot" "$out"
            sz=$(du -h "$out" | cut -f1)
            echo "Screenshot OK: $out ($sz) [Native A11y]"
            exit 0
        fi
        if command -v python3 >/dev/null 2>&1; then
            python3 -c "import urllib.request, sys; urllib.request.urlretrieve('$BRIDGE_URL/shot', sys.argv[1])" "$tmp_shot" 2>/dev/null || true
            if [ -s "$tmp_shot" ] && head -c 8 "$tmp_shot" | grep -q "PNG"; then
                mv -f "$tmp_shot" "$out"
                sz=$(du -h "$out" | cut -f1)
                echo "Screenshot OK: $out ($sz) [Native A11y via Py]"
                exit 0
            fi
        fi
        rm -f "$tmp_shot"
        sleep 0.3
    done

    # Fallback to ADB if native bridge is restarting
    if is_adb_alive; then
        if adb exec-out screencap -p > "$out" 2>/dev/null && [ -s "$out" ]; then
            sz=$(du -h "$out" | cut -f1)
            echo "Screenshot OK: $out ($sz) [Fallback ADB]"
            exit 0
        fi
    fi

    echo "Error taking screenshot: check that OpenCode accessibility service is enabled." >&2
    exit 1
    ;;

  dump)
    out="${1:-/bridge/dump.json}"
    mkdir -p "$(dirname "$out")"
    if curl -s --noproxy "*" --connect-timeout 2 --max-time 6 "$BRIDGE_URL/dump" -o "$out" 2>/dev/null && grep -q '"ok":true' "$out" 2>/dev/null; then
        echo "UI Dump OK: $out [Native JSON]"
        exit 0
    fi

    # Fallback ADB to XML if needed
    if is_adb_alive; then
        adb shell uiautomator dump /data/local/tmp/ui_dump.xml >/dev/null 2>&1
        if adb exec-out cat /data/local/tmp/ui_dump.xml > "$out" 2>/dev/null; then
            echo "UI Dump OK: $out [Fallback ADB XML]"
            exit 0
        fi
    fi
    echo "Error dumping UI hierarchy" >&2
    exit 1
    ;;

  tap)
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: pc tap <X> <Y>" >&2
        exit 1
    fi
    x="$1"
    y="$2"
    if is_bridge_alive; then
        res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 5 "$BRIDGE_URL/tap?x=$x&y=$y" 2>/dev/null || echo "")
        if echo "$res" | grep -q '"ok":true'; then
            echo "Tap OK: ($x, $y) [Native]"
            exit 0
        fi
    fi
    if is_adb_alive; then
        adb shell input tap "$x" "$y"
        echo "Tap OK: ($x, $y) [Fallback ADB]"
        exit 0
    fi
    echo "Error: no bridge available for tap" >&2
    exit 1
    ;;

  swipe)
    if [ -z "$1" ] || [ -z "$2" ] || [ -z "$3" ] || [ -z "$4" ]; then
        echo "Usage: pc swipe <X1> <Y1> <X2> <Y2> [duration_ms]" >&2
        exit 1
    fi
    x1="$1"; y1="$2"; x2="$3"; y2="$4"; dur="${5:-300}"
    if is_bridge_alive; then
        res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 5 "$BRIDGE_URL/swipe?x1=$x1&y1=$y1&x2=$x2&y2=$y2&dur=$dur" 2>/dev/null || echo "")
        if echo "$res" | grep -q '"ok":true'; then
            echo "Swipe OK: ($x1,$y1)->($x2,$y2) ${dur}ms [Native]"
            exit 0
        fi
    fi
    if is_adb_alive; then
        adb shell input swipe "$x1" "$y1" "$x2" "$y2" "$dur"
        echo "Swipe OK: ($x1,$y1)->($x2,$y2) ${dur}ms [Fallback ADB]"
        exit 0
    fi
    echo "Error: no bridge available for swipe" >&2
    exit 1
    ;;

  key)
    k="$1"
    if [ -z "$k" ]; then
        echo "Usage: pc key <HOME|BACK|RECENTS|NOTIFS|POWER|VOLUP|VOLDOWN|ENTER|TAB|ESC>" >&2
        exit 1
    fi
    case "$k" in
      HOME)        action_num=2; keycode=3 ;;
      BACK)        action_num=1; keycode=4 ;;
      RECENTS)     action_num=3; keycode=187 ;;
      NOTIFS)      action_num=4; keycode=83 ;;
      QS)          action_num=5; keycode="" ;;
      LOCK)        action_num=8; keycode=26 ;;
      POWER)       action_num=""; keycode=26 ;;
      VOLUP)       action_num=""; keycode=24 ;;
      VOLDOWN)     action_num=""; keycode=25 ;;
      ENTER)       action_num=""; keycode=66 ;;
      TAB)         action_num=""; keycode=61 ;;
      ESC)         action_num=""; keycode=111 ;;
      *)           action_num=""; keycode="$k" ;;
    esac

    if [ -n "$action_num" ] && is_bridge_alive; then
        res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 5 "$BRIDGE_URL/key?action=$action_num" 2>/dev/null || echo "")
        if echo "$res" | grep -q '"ok":true'; then
            echo "Key OK: $k [Native Global Action]"
            exit 0
        fi
    fi

    if [ -n "$keycode" ] && is_adb_alive; then
        adb shell input keyevent "$keycode"
        echo "Key OK: $k (code $keycode) [Fallback ADB]"
        exit 0
    fi
    echo "Error executing key $k" >&2
    exit 1
    ;;

  text)
    txt="$*"
    if [ -z "$txt" ]; then
        echo "Usage: pc text \"message to type\"" >&2
        exit 1
    fi
    if is_bridge_alive; then
        res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 5 -G --data-urlencode "text=$txt" "$BRIDGE_URL/text" 2>/dev/null || echo "")
        if echo "$res" | grep -q '"ok":true'; then
            echo "Text OK: typed directly into focus field [Native]"
            exit 0
        fi
    fi
    if is_adb_alive; then
        escaped=$(echo "$txt" | sed 's/ /%s/g' | sed 's/[^a-zA-Z0-9%s]/\\&/g')
        adb shell input text "$escaped"
        echo "Text OK: input text [Fallback ADB]"
        exit 0
    fi
    echo "Error: no bridge available for text input" >&2
    exit 1
    ;;

  open)
    target="$1"
    if [ -z "$target" ]; then
        echo "Usage: pc open <package|url>" >&2
        exit 1
    fi
    if is_bridge_alive; then
        res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 5 -G --data-urlencode "pkg=$target" "$BRIDGE_URL/open" 2>/dev/null || echo "")
        if echo "$res" | grep -q '"ok":true'; then
            echo "Open OK: $target [Native]"
            exit 0
        fi
    fi
    if is_adb_alive; then
        if [[ "$target" =~ ^https?:// ]]; then
            adb shell am start -a android.intent.action.VIEW -d "$target" >/dev/null 2>&1
        else
            adb shell monkey -p "$target" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 || \
            adb shell am start -n "$target" >/dev/null 2>&1 || true
        fi
        echo "Open OK: $target [Fallback ADB]"
        exit 0
    fi
    echo "Error opening $target" >&2
    exit 1
    ;;

  click)
    t="$*"
    if is_bridge_alive; then
        res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 5 -G --data-urlencode "t=$t" "$BRIDGE_URL/click" 2>/dev/null || echo "")
        if echo "$res" | grep -q '"ok":true'; then
            echo "Click OK: text '$t' [Native]"
            exit 0
        else
            echo "Element with text '$t' not found" >&2
            exit 1
        fi
    fi
    echo "Error: native bridge required for pc click." >&2
    exit 1
    ;;

  clickid)
    id="$1"
    if is_bridge_alive; then
        res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 5 -G --data-urlencode "id=$id" "$BRIDGE_URL/clickid" 2>/dev/null || echo "")
        if echo "$res" | grep -q '"ok":true'; then
            echo "Click ID OK: '$id' [Native]"
            exit 0
        else
            echo "Element with id '$id' not found" >&2
            exit 1
        fi
    fi
    echo "Error: native bridge required for pc clickid." >&2
    exit 1
    ;;

  scroll)
    dir="${1:-down}"
    if is_bridge_alive; then
        res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 5 "$BRIDGE_URL/scroll?dir=$dir" 2>/dev/null || echo "")
        if echo "$res" | grep -q '"ok":true'; then
            echo "Scroll OK ($dir) [Native]"
            exit 0
        fi
    fi
    echo "Error scrolling." >&2
    exit 1
    ;;

  clipboard)
    if [ "$1" = "set" ]; then
        shift
        t="$*"
        if is_bridge_alive; then
            curl -s --noproxy "*" --connect-timeout 2 --max-time 5 -G --data-urlencode "text=$t" "$BRIDGE_URL/clipboard" >/dev/null 2>&1
            echo "Clipboard updated [Native]"
            exit 0
        elif is_adb_alive; then
            adb shell cmd clipboard set text "$t"
            exit 0
        fi
    else
        if is_bridge_alive; then
            res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 5 "$BRIDGE_URL/clipboard" 2>/dev/null || echo "")
            txt=$(echo "$res" | sed -n 's/.*"text":"\([^"]*\)".*/\1/p')
            echo "$txt"
            exit 0
        elif is_adb_alive; then
            adb shell cmd clipboard get 2>/dev/null || true
            exit 0
        fi
    fi
    ;;

  list)
    filter="$1"
    if is_bridge_alive; then
        curl -s --noproxy "*" --connect-timeout 2 --max-time 8 -G --data-urlencode "filter=$filter" "$BRIDGE_URL/list" 2>/dev/null | \
            grep -o '"pkg":"[^"]*"' | cut -d'"' -f4
        exit 0
    elif is_adb_alive; then
        if [ -n "$filter" ]; then
            adb shell pm list packages | grep -i "$filter" | sed "s/^package://"
        else
            adb shell pm list packages -3 | sed "s/^package://"
        fi
        exit 0
    fi
    ;;

  toast)
    msg="$*"
    if is_bridge_alive; then
        curl -s --noproxy "*" --connect-timeout 2 --max-time 5 -G --data-urlencode "msg=$msg" "$BRIDGE_URL/toast" >/dev/null 2>&1
        exit 0
    fi
    ;;

  notifs)
    "$0" key NOTIFS
    ;;

  notifs-close)
    "$0" key BACK
    ;;

  install)
    apk="$1"
    if [ -z "$apk" ]; then
        echo "Usage: pc install <file.apk>" >&2
        exit 1
    fi
    if [[ "$apk" != /* ]]; then
        apk="$(pwd)/$apk"
    fi
    if [ ! -f "$apk" ]; then
        echo "Error: file $apk does not exist" >&2
        exit 1
    fi

    # 1. If ADB is active, use adb
    local adb_bin="/open-prefix/bin/adb"
    if is_adb_alive; then
        echo "Installing via ADB..."
        if "$adb_bin" -s 127.0.0.1:5555 install -r "$apk" 2>/dev/null; then
            echo "Installation completed [ADB]"
            exit 0
        fi
    fi

    # 2. If ADB is inactive, use Native A11y Bridge (port 4399)
    if is_bridge_alive; then
        echo "Installing via OpenCode Native Bridge (A11y)..."
        mkdir -p /bridge
        cp -f "$apk" /bridge/.open_install.apk
        HOST_PATH="/data/data/a.opencode/files/home/.open-bridge/.open_install.apk"
        res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 25 "$BRIDGE_URL/install?path=$HOST_PATH" 2>/dev/null || echo "")
        if echo "$res" | grep -q '"ok":true'; then
            echo "Installation started and confirmed [Native A11y]"
            exit 0
        else
            echo "Error in native bridge: $res" >&2
            exit 1
        fi
    fi

    echo "Error: no bridge available for installation (A11y or ADB)" >&2
    exit 1
    ;;

  uninstall)
    pkg="$1"
    if [ -z "$pkg" ]; then
        echo "Usage: pc uninstall <package>" >&2
        exit 1
    fi
    local adb_bin="/open-prefix/bin/adb"
    if is_adb_alive; then
        echo "Uninstalling via ADB..."
        if "$adb_bin" -s 127.0.0.1:5555 uninstall "$pkg" 2>/dev/null; then
            echo "Uninstall completed [ADB]"
            exit 0
        fi
    fi
    if is_bridge_alive; then
        echo "Uninstalling via OpenCode Native Bridge (A11y)..."
        res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 15 "$BRIDGE_URL/uninstall?pkg=$pkg" 2>/dev/null || echo "")
        if echo "$res" | grep -q '"ok":true'; then
            echo "Uninstall requested [Native A11y]"
            exit 0
        else
            echo "Error in native uninstall: $res" >&2
            exit 1
        fi
    fi
    echo "Error: no bridge available for uninstall" >&2
    exit 1
    ;;

  wake)
    curl -s --noproxy "*" --connect-timeout 2 "$BRIDGE_URL/wake" >/dev/null 2>&1
    echo "WakeLock requested [Native A11y]"
    ;;

  server)
    curl -s --noproxy "*" --connect-timeout 2 "$BRIDGE_URL/server" >/dev/null 2>&1
    echo "Server mode activated [Native A11y]"
    ;;

  export)
    file="$1"
    dest="${2:-Download}"
    if [ -z "$file" ]; then
        echo "Usage: pc export <file> [destination_dir_or_file]" >&2
        exit 1
    fi
    if [ -f "$file" ]; then
        mkdir -p /bridge
        fname="$(basename "$file")"
        cp -f "$file" "/bridge/$fname"
        file="$fname"
    fi
    if is_bridge_alive; then
        res=$(curl -s --noproxy "*" --connect-timeout 2 --max-time 15 "$BRIDGE_URL/export?file=$file&dest=$dest" 2>/dev/null || echo "")
        if echo "$res" | grep -q '"ok":true'; then
            echo "Export successful: $res"
            exit 0
        else
            echo "Export error via bridge: $res" >&2
        fi
    fi
    if [ -d "/sdcard/Download" ]; then
        cp -f "$file" "/sdcard/Download/" 2>/dev/null && {
            echo "Exported directly to /sdcard/Download/"
            exit 0
        }
    fi
    echo "Error: export failed (neither bridge nor direct /sdcard accessible)" >&2
    exit 1
    ;;

  shell)
    if is_adb_alive; then
        adb shell "$@"
    else
        "$@"
    fi
    ;;

  *)
    echo "Usage: pc <command> [arguments...]"
    echo "Autonomous Native Control (rootless, survives reboots):"
    echo "  pc status                     - General status (native bridge, battery, screen, focus)"
    echo "  pc shot [file.png]            - Instant screenshot (<150ms direct to RAM/PNG)"
    echo "  pc dump [file.json]           - Dump Android UI hierarchy to JSON (<20ms)"
    echo "  pc tap <X> <Y>                - Tap screen at coordinates X Y"
    echo "  pc swipe <X1> <Y1> <X2> <Y2> [MS] - Smooth swipe between two points"
    echo "  pc key <HOME|BACK|RECENTS|...> - System navigation and volume keys"
    echo "  pc text \"text\"                - Type text into focused field"
    echo "  pc open <package|url>         - Open installed app or URL"
    echo "  pc click \"text\"               - Directly click element with specified text"
    echo "  pc clickid \"id\"               - Directly click element with specified view id"
    echo "  pc scroll [down|up]           - Scroll view up or down"
    echo "  pc list [filter]              - List installed apps"
    echo "  pc clipboard [get|set text]   - Read or write Android clipboard"
    echo "  pc toast \"message\"           - Show toast notification"
    echo "  pc install <file.apk>         - Install APK (Native A11y or ADB; survives reboots)"
    echo "  pc uninstall <package>        - Uninstall app (Native A11y or ADB)"
    echo "  pc wake                       - Keep screen/CPU awake (WakeLock)"
    echo "  pc server                     - Start background server"
    echo "  pc shell <command...>         - Execute Android shell command"
    exit 1
    ;;
esac
